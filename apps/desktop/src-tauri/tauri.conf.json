{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypeDance",
  "version": "0.1.11",
  "identifier": "app.typedance.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm --filter @typedance/web dev",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TypeDance",
        "width": 1366,
        "height": 900,
        "decorations": false,
        "dragDropEnabled": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU0M0RBMzMwMDBDNTVFN0MKUldSOFhzVUFNS005NUpxbTJlSUdpT3E0cWxCOXl3SjgyQzdpTEZrckVWTzJPT3ZSdDMzTVhpdlEK",
      "endpoints": [],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": []
  }
}
