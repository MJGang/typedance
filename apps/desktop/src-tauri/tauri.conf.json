{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TypeDance",
  "version": "0.1.0",
  "identifier": "app.typedance.desktop",
  "build": {
    "beforeDevCommand": "corepack pnpm --filter @typedance/web dev",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "TypeDance",
        "width": 1366,
        "height": 900,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [],
    "icon": [],
    "resources": []
  }
}
